{
  "name": "@seintje/svelte",
  "version": "0.1.3",
  "description": "Svelte 5 bindings for Seintje toast notifications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "svelte",
    "toast",
    "notification",
    "seintje"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinkosterr/seintje.git",
    "directory": "packages/svelte"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && cp ../seintje/dist/styles.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "seintje": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
